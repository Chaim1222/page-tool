        },
        {
          "endpoint": "local",
          "params": {
            "action": "query",
            "format": "json",
            "indexpageids": 1,
            "ppprop": "disambiguation",
            "prop": "info|pageprops",
            "redirects": 1,
            "titles": "חדש",
            "utf8": 1
          }
        }
      ],
      "scripts": [
        "Gadget page tool.preview.js"
      ]
