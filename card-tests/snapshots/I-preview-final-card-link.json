            "format": "json",
            "list": "backlinks",
            "utf8": 1
          }
        },
        {
          "endpoint": "local",
          "params": {
            "action": "query",
            "blfilterredir": "redirects",
            "bllimit": "max",
            "blnamespace": 0,
            "bltitle": "מקומי",
            "format": "json",
            "list": "backlinks",
            "utf8": 1
          }
        },
        {
          "endpoint": "local",
          "params": {
            "action": "query",
            "format": "json",
            "indexpageids": 1,
            "ppprop": "disambiguation",
            "prop": "info|revisions|pageprops",
            "rvlimit": 1,
            "rvprop": "ids|size|content",
            "titles": "חדש",
            "utf8": 1
          }
