      ]
    },
    {
      "step": "1:העברה-חסומה",
      "dom": {
        "tool": [
          "div#hmk-tool.hmk-tool",
          "  div.hmk-card.hmk-card-warning [dir=rtl]",
          "    svg.hmk-icon",
          "    div.hmk-body",
          "      div.hmk-title \"היעד תפוס\"",
          "      div.hmk-text \"כדי להעביר יש למחוק תחילה את הדף בכותרת היעד. ערך ויקיפדיה אחר (פריט היעד Q2 מול Q1 של הדף הנוכחי)\"",
          "      div.hmk-action-status [role=status hidden]",
          "      div.hmk-actions",
