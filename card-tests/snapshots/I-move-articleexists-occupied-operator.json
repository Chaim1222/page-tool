      },
      "reads": [
        {
          "endpoint": "local",
          "params": {
            "action": "query",
            "format": "json",
            "indexpageids": 1,
            "ppprop": "disambiguation",
            "prop": "info|revisions|pageprops",
            "rvlimit": 1,
            "rvprop": "ids|size|content",
            "titles": "חדש",
            "utf8": 1
