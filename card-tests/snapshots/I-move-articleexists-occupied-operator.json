      "writes": [
        {
          "api": "postWithToken",
          "outcome": "error:articleexists",
          "params": {
            "action": "move",
            "format": "json",
            "from": "מקומי",
            "movesubpages": 1,
            "movetalk": 1,
            "noredirect": 1,
            "reason": "השוואה לוויקיפדיה העברית",
            "to": "חדש"
          },
          "token": "move"
        }
      ]
    }
